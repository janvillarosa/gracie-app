# Frontend environment (Vite). Copy to `.env.local` (gitignored). Everything is optional.

# --- Map tiles -------------------------------------------------------------------------
# The Protomaps hosted API key. With it, trips use the real map (tiles from
# https://api.protomaps.com/tiles/v4.json). Without it, trips draw the plain "Map preview"
# (stops, route and labels on a paper ground), which is also what runs in dev by default.
# Restrict the key to this app's domains in the Protomaps dashboard: it ships in the bundle.
# The hosted API forbids bulk offline prefetch, so there is no tile cache beyond the browser's.
VITE_PROTOMAPS_API_KEY=

# Where map labels get their glyphs (a URL with {fontstack} and {range}). Leave empty and the
# map shows pips and the route without text labels; the hovered stop gets a small tag instead.
# VITE_GLYPHS_URL=

# --- Local development with the mock trips server ----------------------------------------
# VITE_MOCK_TRIPS=1   (dev builds only: serves the trips API from an in-browser mock)
