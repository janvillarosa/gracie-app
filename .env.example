# gracie-app — example environment configuration
#
# Copy to `.env` (gitignored) and adjust as needed. Every variable has a safe
# default in code, so an empty .env still boots against local defaults. The
# canonical datastore is MongoDB; a single-node replica set is required for
# transactions (docker-compose provisions this automatically).

# ── Backend: server ─────────────────────────────────────────────────────────
PORT=8080
# Path to the AES-256-GCM key file (created on first boot if absent).
# Local dev / docker-compose bind-mounts ./.secrets/enc.key here.
ENC_KEY_FILE=./.secrets/enc.key
# API key time-to-live, in hours (default 720 = 30 days).
API_KEY_TTL_HOURS=720
# Salt used to derive deterministic avatar keys (HMAC of user_id).
AVATAR_SALT=local-avatar-salt
# Production CORS: if set, only this origin is allowed (with credentials); if unset,
# all origins are allowed without credentials. Not needed when the frontend proxies
# /api/* (Vercel rewrite / nginx). Read directly by internal/http/router.
# CORS_ORIGIN=https://your-frontend-domain

# ── Backend: MongoDB (the only supported store) ─────────────────────────────
# Local standalone Mongo works for most tests, but transactions (signup, join,
# deletion-by-consensus) require a replica set. docker-compose sets:
#   mongodb://mongo:27017/?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gracie

# ── Backend: embedding categorization (in-process ONNX MiniLM) ──────────────
# When false, categorization falls back to keyword/vector heuristics only.
EMBEDDING_ENABLED=false
EMBEDDING_MODEL_PATH=/app/models/minilm
EMBED_THRESHOLD=0.45
EMBED_TOPK=5
# Mongo-backed category cache (speeds up repeat categorizations). Default on.
CATEGORY_INDEX_ENABLED=true

# ── Backend: tests only ─────────────────────────────────────────────────────
# Set to a downloaded MiniLM ONNX model dir to run the real-model integration
# test (`make test-integration`); unset → that test skips.
# TEST_MODEL_PATH=/path/to/models/minilm

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Dev-server proxy target for /api/* (see frontend/vite.config.ts). Do NOT set
# a relative value in Vercel — Vercel rewrites /api/* to the backend instead.
VITE_API_BASE_URL=http://localhost:8080
# Live-query polling intervals (milliseconds).
VITE_LIVE_QUERY_LISTS_MS=4000
VITE_LIVE_QUERY_ITEMS_MS=2000

# ── Backend: Trips & places ─────────────────────────────────────────────────
# Photon-compatible geocoder base URL for place search. Public photon.komoot.io is
# fair-use only; self-host or use a commercial OSM provider in production.
# When unset, /places/* return {"results":[],"degraded":true} and clients fall back
# to manual places / dropped pins.
# PHOTON_BASE_URL=https://photon.komoot.io
# Per-user and server-wide request rates (tokens/second; burst is 4x).
TRIPS_USER_RPS=5
PLACES_USER_RPS=2
PLACES_SERVER_RPS=5
