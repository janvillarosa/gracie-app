# OS-specific
.DS_Store
Thumbs.db

# Logs
*.log
logs/
log/

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Project binaries / build dirs
bin/
build/
dist/
out/
tmp/

# Go test and profiling outputs
cover.out
coverage.out
coverage/
*.coverprofile
*.cover
*.prof
*.pprof
profile.out
cpu.pprof
mem.pprof
heap.pprof

# Go compile/cache/tmp (when redirected locally; the Makefile's gofmt walk skips these too)
backend/*.gocache/
backend/.gocache*
backend/.gotmp*

# Environment and local config
.env
.env.*
!.env.example
.envrc
.direnv/

# Editor/IDE
.vscode/
.idea/
*.iml
*.code-workspace
*.swp
*.swo

# MongoDB (local dev volume)
.mongo/

# Node / frontend
node_modules/
frontend/node_modules/
frontend/.vite/
frontend/dist/
frontend/dist-ssr/

# Local secrets
.secrets/

# Downloaded ONNX models (fetched at build time by cmd/fetch-model)
backend/models/

# Coding-agent and tool state (local to each machine/session; never commit)
# .claude/ holds worktrees and personal settings; launch.json is the shared dev-server config.
.claude/*
!.claude/launch.json
.superpowers/
.playwright-mcp/
.agents/
.taste-skill/
skills-lock.json
qa-shots/
# Impeccable: design.json, config.json, mocks/ and surfaces/ are tracked; its working state is not.
.impeccable/hook.*
.impeccable/config.local.json
.impeccable/questions/
.impeccable/review/
